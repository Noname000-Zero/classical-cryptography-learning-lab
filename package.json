{
  "name": "football-learning-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint web server tests",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts server/*.test.ts",
    "test:runner": "tsx --test --test-concurrency=1 server/runner.test.ts",
    "test:browser": "playwright test",
    "catalog": "node tools/catalog.mjs"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@monaco-editor/react": "^4.7.0",
    "@yowasp/clang": "22.0.0-git20695-13",
    "express": "^5.1.0",
    "koffi": "3.3.8",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.65.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.1.0"
  }
}
