# Set these in the launching terminal. App does not auto-load .env.
PORT=3001
# ACADEMY_DATA_DIR=path/to/private-runtime
# C++ WASM runner works without these tutor settings.
# Tutor remains disconnected until explicitly configured. No default paid provider.
# Full OpenAI-compatible Chat Completions URL (HTTPS, or HTTP on loopback only).
# TUTOR_API_URL=https://YOUR_PROVIDER/v1/chat/completions
# TUTOR_MODEL=YOUR_MODEL
# TUTOR_API_KEY=set_in_backend_environment_only
